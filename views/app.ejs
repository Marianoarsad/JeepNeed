<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App</title>

    <link rel="stylesheet" href="styles/app.css">
    
    <!-- Leaflet css -->
    <link 
        rel="stylesheet" 
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
    />

    <!-- Leaflet routing machine css -->
    <link 
        rel="stylesheet" 
        href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" 
    />
</head>
<body>
    <!-- Map Container -->
    <div id="map" ></div>
    
    <!-- Javascript -->

    <!--Leaflet script-->
    <script 
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
    </script>

    <!-- Leaflet routing machine js -->
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>

    <script> 

        function success() {
            
            // PASSENGER ICON
            var passengerIcon = L.icon({
                iconUrl: "images/person-icon.png",
                iconSize: [35, 35]
            });

            var passenger = L.marker([14.6295,  121.0418], {icon: passengerIcon}).addTo(map);

            // PASSENGER CIRCLE
            var passengerRadius = L.circle([14.6295,  121.0418], {
                stroke: false,
                fillColor: '#FAA300',
                fillOpacity: 0.06,
                radius: 30
            }).addTo(map);
        
            passengerRadius.bindPopup("I am infont of CIIT Campus.");

        }

        // Error Handler
        function error (error) {
            throw new Error('Your browser is not compatible.');
        }

        // Map Initialize
        navigator.geolocation.watchPosition(success, error);

        // JEEPNEY ICON 🚚
        const jeepneyIcon = L.icon({
            iconUrl: "images/jeepney-icon.png",
            iconSize: [35, 35],
        });

        // ORIGIN ICON 📍
        const originIcon = L.icon({
            iconUrl: "images/origin-icon.png",
            iconSize: [40, 40]
        });

        // DESTINATION ICON 📍
        const destinationIcon = L.icon({
            iconUrl: "images/destination-icon.png",
            iconSize: [40, 40]
        });

        // MAP LAYER 🗺️
        var map = L.map('map', {
            zoomControl: false
        }).setView([
            14.6295,  
            121.0418
        ], 20);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_labels_under/{z}/{x}/{y}{r}.png', {
            maxZoom: 20,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }).addTo(map);

        // Jeepney routes
        var proj23 = L.marker([14.632945071026535, 121.01690331131708], { icon: jeepneyIcon }).addTo(map); // Jeepney Marker
            
        // ROUTES
        L.Routing.control({
            waypoints: [
                null
            ],
            plan: L.Routing.plan([
                // PROJECT 2-3
                L.latLng(14.633032939049171, 121.01702489256556),
                L.latLng(14.636197737903148, 121.02919736200919),
                L.latLng(14.627772665780878, 121.03539908600466),
                L.latLng(14.634152037467478, 121.05895033389389),
                L.latLng(14.628929938956487, 121.06475481553743)
            ], {
                // ORIGIN - DESTINATION ICON PLACEMENT
                createMarker: function(i, wp, nWps) {

                    if (i === 0) {
                        return L.marker(wp.latLng, {icon: originIcon });
                    }

                    if (i === 4) {
                        return L.marker(wp.latLng, {icon: destinationIcon });
                    } 
                }
            }),
            // LINE PATH CONFIGURATIONS
            lineOptions: {
                addWaypoints: false,
                styles: [{ color: '#59D5E0', 
                opacity: 0.8, 
                weight: 5 
                }]
            },
        }).on('routesfound', (e) => {

            function toRadian(degree) {
                return degree*Math.PI/180;
            }

            function getDistance(origin, destination) {
            
                    // DISTANCE IN METERS 
                    var lon1 = toRadian(origin[1]),
                        lat1 = toRadian(origin[0]),
                        lon2 = toRadian(destination[1]),
                        lat2 = toRadian(destination[0]);

                    var deltaLat = lat2 - lat1;
                    var deltaLon = lon2 - lon1;

                    var a = Math.pow(Math.sin(deltaLat/2), 2) + Math.cos(lat1) * Math.cos(lat2) * Math.pow(Math.sin(deltaLon/2), 2);
                    var c = 2 * Math.asin(Math.sqrt(a));
                    var EARTH_RADIUS = 6371;

                    return (c * EARTH_RADIUS * 1000);
                
            }

            function pickupPassenger (jeep, coordinates) {

                return new Promise( (resolve, reject) => {
                    for (let x = 0; x <= 158; x++) {

                        //var distance = getDistance([14.6295,  121.0418], [coordinates[x].lat, coordinates[x].lng]);

                        setTimeout( function () {

                            jeep.setLatLng([coordinates[x].lat, coordinates[x].lng]);

                            if (x == 158) {
                                
                                console.log("Jeepney has arrived at your location. You have 5 minutes before Jeepney departs.");

                                setTimeout( function () {
                                    console.log("Successfully boarded.");
                                    resolve();
                                }, 10000)

                            }

                        }, 500 * x);
                    }
                })
                
            }

            function deliverPassenger (jeep, coordinates) {
                console.log("\nJeepney has departed.");

                    let delay = 0;

                    for (let x = 158; x < coordinates.length; x++) {
                        //var distance = getDistance([14.6295,  121.0418], [coordinates[x].lat, coordinates[x].lng]);
                        delay++;
                        setTimeout( function () {

                            jeep.setLatLng([coordinates[x].lat, coordinates[x].lng]);

                            if (x === coordinates.length - 1 ) {
                                console.log('*** Jeepney has arrived to the destination! ***');
                            }

                        }, 500 * delay);
                    }
            }

            async function app (jeepMarker, coordinatesArray, pickupPassenger, deliverPassenger) {
                await pickupPassenger(jeepMarker, coordinatesArray);
                deliverPassenger(jeepMarker, coordinatesArray);
            }

            let coordinates = [...e.routes[0].coordinates];
            let passengerCtr = 20;
            var jeepneyPopup = L.popup({className: 'jeepneyPopup'})
                .setContent(`
                    <h3>Project 2-3</h3><br>
                    <p>${passengerCtr}/23</p><br>
                    <button id="btn"><b>Ride</b></button> </p>
                `)
            

            proj23.bindPopup(jeepneyPopup);
            proj23.on('popupopen', function() {
            document.getElementById("btn").addEventListener('click', function () {
                
                passengerCtr++;
                console.log(passengerCtr);

                popupContent = `
                    <h3>Project 2-3</h3><br>
                    <p>Waiting to fill the jeepney.</p>
                    <p>${passengerCtr}/23</p><br>
                    <button id="btn">Cancel.</button>
                `

                proj23.setPopupContent(popupContent);
                
                if (passengerCtr == 23) {
                    popupContent = `
                        <p>Jeepney has departed!</p><br>
                        <button id="btn">Cancel</button>
                    `

                    proj23.setPopupContent(popupContent);
                    console.log("*** Jeepney has departed from terminal! ***");
                    
                    app(proj23, coordinates, pickupPassenger, deliverPassenger);
                }
            });
            })
             
        }).addTo(map);
    
    </script>
</body>
</html>

